{
  "manifest_version": 3,
  "name": "Table to Excel Exporter",
  "version": "1.0",
  "description": "Adds a button to export any table on the page to .xlsx",
  "permissions": ["activeTab", "downloads"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["xlsx.full.min.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
